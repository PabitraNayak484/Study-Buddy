# Copy this file to .env for local development and fill in your key.
# NEVER commit the real .env file to version control.

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the default model
GEMINI_MODEL=gemini-2.5-flash

# Optional: comma-separated list of extra origins allowed to call this API
# cross-site, e.g. "https://example.com". Leave blank (the default) unless
# you specifically need another site to call this API - same-origin calls
# (the app calling its own backend) never need this set.
ALLOWED_ORIGINS=

# Optional: max requests per visitor per rolling 60-second window across all
# /api/* routes. Protects your Gemini free-tier quota from being exhausted
# by any one visitor during a demo/showcase.
RATE_LIMIT_PER_MINUTE=12

# Optional: max upload size (in MB) accepted by /api/extract (PDF/DOCX/image).
MAX_UPLOAD_MB=8
